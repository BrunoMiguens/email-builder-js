{
  "name": "@push-labs/email-builder",
  "version": "1.3.2",
  "description": "React component to render email messages",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/push-co/email-builder-js.git",
    "directory": "packages/email-builder"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup ./src/index.ts --outDir dist --format cjs,esm --dts"
  },
  "author": "carlos@usewaypoint.com",
  "license": "MIT",
  "peerDependencies": {
    "react": "^16 || ^17 || ^18",
    "react-dom": "^16 || ^17 || ^18",
    "zod": "^1 || ^2 || ^3"
  },
  "devDependencies": {
    "@push-labs/block-avatar": "^0.0.3",
    "@push-labs/block-button": "^0.0.3",
    "@push-labs/block-columns-container": "^0.0.3",
    "@push-labs/block-container": "^0.0.2",
    "@push-labs/block-divider": "^0.0.4",
    "@push-labs/block-heading": "^0.0.3",
    "@push-labs/block-html": "^0.0.3",
    "@push-labs/block-image": "^0.0.5",
    "@push-labs/block-spacer": "^0.0.3",
    "@push-labs/block-text": "^0.0.7",
    "@push-labs/document-core": "^0.0.6"
  },
  "dependencies": {
    "sanitize-html": "^2.17.6"
  }
}
